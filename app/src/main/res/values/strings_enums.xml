    <string name="guarded_accessibility_explanation">The keyword and chat guards read a screen\'s text through this. Without it they stop watching.</string>
    <string name="guarded_device_owner_label">Device owner</string>
    <string name="guarded_device_owner_explanation">The strongest part of the lock - suspension, hiding apps, kiosk - runs on this.</string>

