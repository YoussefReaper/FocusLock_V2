<?xml version="1.0" encoding="utf-8"?>
<!--
    The labels and one-line explanations for every enum a person picks from:
    per-app policy, app category, guard action, place trigger, the three parts
    of a custom rule, and how a task proves itself.

    These lived in Kotlin as constructor arguments, so they were unreachable by
    any locale mechanism. The enums now carry @StringRes ids and resolve through
    the Context - see AppPolicy, AppCategory, GuardAction, PlaceTrigger,
    RuleTargetType, RuleConditionType, RuleAction, Verification, Priority,
    Recurrence and PermissionGuard.Guarded.
-->
<resources>
    <!-- AppPolicy: what FocusLock is allowed to do about one app. -->
    <string name="policy_allow_label">Open freely</string>
    <string name="policy_allow_blurb">No pause, no limit. This app is fine.</string>
    <string name="policy_allow_short">Open</string>
    <string name="policy_friction_label">Pause first</string>
    <string name="policy_friction_blurb">A few slow seconds and a way out before it opens.</string>
    <string name="policy_friction_short">Pause</string>
    <string name="policy_limit_label">Give it a budget</string>
    <string name="policy_limit_blurb">Opens freely until the daily budget runs out.</string>
    <string name="policy_limit_short">Budget</string>
    <string name="policy_block_label">Blocked</string>
    <string name="policy_block_blurb">Does not open while a session is running.</string>
    <string name="policy_block_short">Blocked</string>
    <string name="policy_hide_label">Blocked and hidden</string>
    <string name="policy_hide_blurb">Does not open, and disappears from the launcher.</string>
    <string name="policy_hide_short">Hidden</string>

