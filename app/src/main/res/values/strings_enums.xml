    <!-- PermissionGuard.Guarded: the permissions the lock depends on. -->
    <string name="guarded_usage_access_label">Usage access</string>
    <string name="guarded_usage_access_explanation">Every rule depends on knowing which app is in front. Without this, FocusLock cannot see anything running.</string>
    <string name="guarded_overlay_label">Display over other apps</string>
    <string name="guarded_overlay_explanation">This is what draws the block screen on top of a blocked app.</string>
