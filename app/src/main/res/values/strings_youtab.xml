    <string name="youtab_reset_subtitle">A factory reset is the ultimate way out of a kiosk session, and FocusLock never blocks it. It erases the phone, so it stays behind a countdown.</string>
    <string name="youtab_reset_button">Factory reset this phone</string>
    <string name="youtab_reset_confirm_title">Erase everything on this phone?</string>
    <string name="youtab_reset_confirm_message">Every app, photo and message goes. This is not how a session is meant to end, and there is no undo.</string>
    <string name="youtab_reset_confirm_button">Erase the phone</string>
    <string name="youtab_reset_settings_only">Reset is only reachable from Settings on this phone.</string>

    <string name="youtab_about">FocusLock. Everything it knows about you stays on this phone.</string>

    <!-- ══ Problem reports (Diagnostics) ══ -->
    <string name="diag_report_title">Report a problem</string>
    <string name="diag_report_subtitle">Nothing is sent until you choose where</string>
    <string name="diag_report_subtitle_crash">Last crash %1$s · nothing is sent until you choose where</string>
    <string name="diag_confirm_title">Send a problem report?</string>
    <string name="diag_confirm_message">The report holds FocusLock\'s version, your phone model and Android version, which permissions are on, the last few crashes, and FocusLock\'s own recent log - which can name apps it blocked and Telegram chats it read. Nothing from other apps.\n\nYou pick where it goes next, and you can read all of it before you send.</string>
    <string name="diag_confirm_send">Prepare report</string>
    <string name="diag_share_title">Send the report with</string>
    <string name="diag_crash_card_title">FocusLock crashed</string>
    <string name="diag_crash_card_body">It stopped unexpectedly on %1$s. A report helps fix it - nothing is sent unless you send it.</string>
    <string name="diag_crash_card_send">Send a report</string>
    <string name="diag_crash_card_dismiss">Not now</string>

