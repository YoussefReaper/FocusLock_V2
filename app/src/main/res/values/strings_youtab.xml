    <string name="youtab_adb_off_title">ADB debugging is off</string>
    <string name="youtab_adb_turn_off">Turn off ADB debugging</string>
    <string name="youtab_adb_off_detail">Closed by you. It reopens when a session that hands the phone back ends.</string>
    <string name="youtab_adb_subtitle">Closes the computer-side route into the phone. It only happens if you tap it.</string>
    <string name="youtab_device_owner_needed_title">Device Owner needed</string>
    <string name="youtab_device_owner_needed_detail">Only a Device Owner can close ADB. Set that up from a computer first.</string>
    <string name="youtab_adb_confirm_title">Turn off ADB debugging?</string>
    <string name="youtab_adb_confirm_message">This closes the developer route into the phone while FocusLock is Device Owner. You would need a factory reset, or a session that hands the phone back, to reopen it.</string>
    <string name="youtab_adb_confirm_button">Turn it off</string>
    <string name="youtab_restriction_refused">Android refused that restriction.</string>

